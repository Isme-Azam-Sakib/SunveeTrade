# ---------------------------------------------------------------------------
# Sunvee Trade International — environment variables (technical spec §7)
#
# Copy to `.env.local` for development. Never commit real values.
# Production/Preview values live in Vercel's environment variable manager,
# scoped per environment.
# ---------------------------------------------------------------------------

# Public site origin. Used for canonical URLs, sitemap.xml and robots.txt.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Images (§4) -----------------------------------------------------------
# Public base URL of the R2 bucket / custom domain, e.g.
# "https://cdn.sunveeintl.com". Leave EMPTY in local development to serve the
# placeholder assets from `public/media` instead.
NEXT_PUBLIC_IMAGE_CDN_DOMAIN=""

# Upload-script credentials (dev-side only, never exposed to the client).
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""

# --- Quote form (§5) -------------------------------------------------------
# Transactional email delivery.
RESEND_API_KEY=""
# Verified sending identity on the Resend account.
QUOTE_FROM_EMAIL="Sunvee Website <website@sunveeintl.com>"
# Destination address(es) for quote requests. Comma-separated for several.
SALES_NOTIFICATION_EMAIL="sohag@sunveeintl.com"

# Backup lead log. The private key is the full PEM including the
# "-----BEGIN PRIVATE KEY-----" header; newlines may be written as \n.
GOOGLE_SHEETS_CLIENT_EMAIL=""
GOOGLE_SHEETS_PRIVATE_KEY=""
GOOGLE_SHEETS_SPREADSHEET_ID=""
# Sheet (tab) that submissions are appended to.
GOOGLE_SHEETS_SHEET_NAME="Leads"

# Spam protection. Both keys come from the Cloudflare Turnstile dashboard.
# Leave empty to disable the challenge (local development only).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
