# ---------------------------------------------------------------------------
# Sunvee Trade International — environment variables (technical spec §7)
#
# Copy to `.env.local` for development. Never commit real values.
# Production/Preview values live in Vercel's environment variable manager,
# scoped per environment.
# ---------------------------------------------------------------------------

# Public site origin. Used for canonical URLs, sitemap.xml and robots.txt.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Images (§4) -----------------------------------------------------------
# Public base URL of the R2 bucket / custom domain, e.g.
# "https://cdn.sunveeintl.com". Leave EMPTY in local development to serve the
# placeholder assets from `public/media` instead.
NEXT_PUBLIC_IMAGE_CDN_DOMAIN=""

# Upload-script credentials (dev-side only, never exposed to the client).
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""

# --- Quote form (§5) -------------------------------------------------------
# Submissions are emailed to the sales webmail inbox via Resend.
# Create a free key at https://resend.com — without it, local submits only
# log to the server console.
RESEND_API_KEY=""
# Verified sending identity on the Resend account (domain must be verified
# for production). Until then Resend's onboarding address works for tests.
QUOTE_FROM_EMAIL="Sunvee Website <website@sunveeintl.com>"
# Webmail inbox that receives quote requests. Comma-separated for several.
# Defaults to sales@sunveeintl.com when left empty.
SALES_NOTIFICATION_EMAIL="sales@sunveeintl.com"

# Spam protection. Both keys come from the Cloudflare Turnstile dashboard.
# Leave empty to disable the challenge (local development only). Required
# in production — the API refuses unverified submissions without them.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
