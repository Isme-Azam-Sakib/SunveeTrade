# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ---------------------------------------------------------------------------
# Product photography (technical spec §4)
#
# Images live in Cloudflare R2, NOT in git — repo size, clone/CI time and
# Vercel deploy limits all degrade with a large, growing photo catalog.
# `public/media` is the local staging area: drop new photography here, preview
# it with `npm run dev`, then publish it with `npm run media:upload`.
# ---------------------------------------------------------------------------
/public/media/

# next-sitemap output
/public/sitemap*.xml
/public/robots.txt

# env files, but keep the documented template
!.env.example
